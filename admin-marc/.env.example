APP_NAME="EBOLO Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Africa/Douala

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de données -------------------------------------------------------
# SQLite : zéro configuration (le fichier database/database.sqlite est créé par `composer setup`)
DB_CONNECTION=sqlite

# PostgreSQL (identique au projet Next.js d'origine) :
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=ebolo
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# MySQL / MariaDB (XAMPP, Laragon, WAMP…) :
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ebolo
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- Compte administrateur créé par `php artisan db:seed` -------------------
ADMIN_EMAIL=admin@ebolo.com
ADMIN_PASSWORD=admin123
# Mettre à false en production : ne crée alors QUE le compte administrateur
SEED_DEMO_DATA=true

VITE_APP_NAME="${APP_NAME}"
